{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "在瀏覽器開啟 天堂放置版 (Local Server)",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:8080/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "直接以檔案開啟 index.html",
            "type": "msedge",
            "request": "launch",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "name": "Python Debugger: Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}"
        }
    ]
}